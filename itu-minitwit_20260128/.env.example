# =========================
# Application Configuration
# =========================

# MongoDB connection string
# Replace <db-ip> with the IP of the dbserver droplet
MONGO_URI=mongodb://<db-ip>:27017/minitwit

# Flask environment
FLASK_ENV=production

# =========================
# Infrastructure
# =========================

# Email used by Certbot for SSL certificates
LETSENCRYPT_EMAIL=your-email@example.com

# DigitalOcean Reserved IP (used for stable domain)
DIGITAL_OCEAN_RESERVED_IP=your_reserved_ip_here